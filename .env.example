# Environment variables for LLM Sandbox
# Copy this file to .env and modify as needed

# Gemini API Key (optional - system will use fallback key if not provided)
GEMINI_API_KEY=

# Gemini model to use
GEMINI_MODEL=gemini-3.6-flash

# Database URL (defaults to sqlite+aiosqlite:///./sandbox.db)
DATABASE_URL=sqlite+aiosqlite:///./sandbox.db

# Rate limiting: requests per minute per IP
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW=60

# Whether to allow user-provided API keys (for participants)
ALLOW_USER_API_KEYS=true

# Challenge flag (set in production)
CHALLENGE_FLAG=

# Maximum prompt length
MAX_PROMPT_LENGTH=4000
